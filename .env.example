# PostgreSQL connection for the Ops Tracker's own database. `npm run db:init` creates a project-local cluster
# (./.pgdata, user "opstracker", trust auth) on 127.0.0.1:5434; elsewhere use any PostgreSQL and its credentials.
DATABASE_URL="postgresql://opstracker@127.0.0.1:5434/opstracker?schema=public"
# Direct (non-pooled) connection, used by migrations. Locally the same as DATABASE_URL; on Supabase DATABASE_URL is the
# pooled "Transaction" URL (port 6543, add ?pgbouncer=true) and DIRECT_URL the "Session"/direct one (port 5432).
DIRECT_URL="postgresql://opstracker@127.0.0.1:5434/opstracker?schema=public"

# Set to "true" on a deployment that should publish only the Task Pipeline (plus sign-in).
# PIPELINE_ONLY="true"
